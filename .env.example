# Server
PORT=3000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER_ORDER=gemini
GEMINI_MODEL=gemini-2.0-flash

# OCR cục bộ bằng Tesseract.js (không gửi ảnh sang AI)
# Có thể dùng eng nếu chỉ cần tiếng Anh để khởi động nhanh hơn.
OCR_LANGUAGES=vie+eng
# Chỉ gửi ảnh sang Gemini khi confidence Tesseract thấp hơn ngưỡng này (0-100).
OCR_AI_FALLBACK_CONFIDENCE=75
# Đường dẫn interpreter của virtual environment PaddleOCR.
PADDLE_OCR_PYTHON=.venv-ocr/Scripts/python.exe

# Neon PostgreSQL
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_SERVER=your_neon_host
DB_NAME=neondb
DB_PORT=5432
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Ngưỡng đối chiếu (điểm tối thiểu để coi là MATCHED, 0-100)
MATCH_THRESHOLD=70
