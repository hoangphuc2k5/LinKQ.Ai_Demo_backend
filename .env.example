# Server
PORT=3000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# SQL Server
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_SERVER=localhost
DB_NAME=PaymentMatchingDB
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Ngưỡng đối chiếu (điểm tối thiểu để coi là MATCHED, 0-100)
MATCH_THRESHOLD=70

# Neon PostgreSQL
DATABASE_URL=your_neon_database_url
DATABASE_URL_UNPOOLED=your_neon_unpooled_database_url
PGHOST=your_neon_pooler_host
PGHOST_UNPOOLED=your_neon_unpooled_host
PGUSER=your_neon_user
PGDATABASE=neondb
PGPASSWORD=your_neon_password
POSTGRES_URL=your_neon_database_url
POSTGRES_URL_NON_POOLING=your_neon_unpooled_database_url
POSTGRES_USER=your_neon_user
POSTGRES_HOST=your_neon_pooler_host
POSTGRES_PASSWORD=your_neon_password
POSTGRES_DATABASE=neondb
POSTGRES_URL_NO_SSL=your_neon_url_without_ssl
POSTGRES_PRISMA_URL=your_neon_prisma_url
